# Backend API base URL.
# - Local dev:    http://localhost:5000
# - Production:   leave empty ("") if frontend and backend share the same origin,
#                 OR set to your deployed backend URL e.g. https://api.yourdomain.com
VITE_API_URL=http://localhost:5000

# Public-facing site URL (used for referral share links and SSR meta tags).
# - Local dev:    http://localhost:3000
# - Production:   https://yourdomain.com  (no trailing slash)
VITE_PUBLIC_URL=http://localhost:3000



VITE_API_URL=http://localhost:5000
VITE_PUBLIC_URL=http://localhost:5173
