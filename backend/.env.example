PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/anandotsav
CORS_ORIGIN=http://localhost:5173,http://localhost:8082
HMAC_SECRET=change-me-hmac-secret-min-32-chars-long!!
JWT_SECRET=change-me-jwt-secret-min-32-chars-long!!!!
JWT_EXPIRY=2h
EVENT_YEAR=2026
# Optional: set TRUST_PROXY=true only when behind a reverse proxy outside production NODE_ENV
# TRUST_PROXY=false

# Public frontend URL (no trailing slash) — used in WhatsApp captions /find link
PUBLIC_APP_URL=http://localhost:5173

# WhatsApp (Baileys) — transactional registration QR only. Off by default.
# Registration always succeeds even when WhatsApp is down or disabled.
# Queue is MongoDB-backed (WhatsAppMessage). Never in-memory only.
WHATSAPP_ENABLED=false
WHATSAPP_SESSION_DIR=./data/whatsapp-session
WHATSAPP_SEND_REGISTRATION_CONFIRMATION=true
WHATSAPP_SEND_REGISTRATION_QR=true
WHATSAPP_MAX_ATTEMPTS=3
WHATSAPP_WORKER_INTERVAL_MS=15000
Always 1 — sequential delivery only (no concurrent registration sends)
WHATSAPP_MAX_CONCURRENT_SENDS=1
Random delay between successful sends (not a claimed WhatsApp-safe rate)
WHATSAPP_MIN_DELAY_MS=5000
WHATSAPP_MAX_DELAY_MS=12000
Circuit breaker: pause worker after N consecutive send failures
WHATSAPP_MAX_CONSECUTIVE_FAILURES=3
WHATSAPP_COOLDOWN_MS=300000
WHATSAPP_EVENT_DATE=6 September 2026
WHATSAPP_EVENT_VENUE=Sri Gokul Gaushala, Amritsar
